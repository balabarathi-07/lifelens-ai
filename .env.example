# All optional. Defaults shown.
LIFELENS_HOST=127.0.0.1
LIFELENS_PORT=8000
LIFELENS_MODEL_PATH=models/detector.onnx
LIFELENS_MODEL_NAME=YOLOv8n (ONNX, COCO-80)
# auto | qnn | dml | cpu
LIFELENS_PROVIDER=auto
LIFELENS_MIN_CONFIDENCE=0.35
LIFELENS_MOVE_DISTANCE=0.06
LIFELENS_ALLOW_DEMO_DETECTOR=1
LIFELENS_DATA_DIR=data
